PORT=3000
APP_URL=https://yourdomain.com


FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI requests allowed per user per 5 minutes
# AI_RATE_LIMIT=30

# Optional: encrypt per-room GitHub tokens at rest (any long random string,
# e.g. `openssl rand -base64 32`). Keep it — tokens saved with it need it to be read.
SECRETS_KEY=

# Optional server-wide GitHub token used when a room has none of its own
# (fine-grained PAT with Contents: read & write).
GITHUB_TOKEN=

# Optional TURN server for voice chat behind strict NATs (comma-separate several URLs)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=


MAIL_HOST=mail.yourdomain.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noreply@yourdomain.com
MAIL_PASS=your-email-password
MAIL_FROM=Learnkins Room <noreply@yourdomain.com>