{
  "version": 2,
  "builds": [
    {
      "src": "app/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "app/public/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "app/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "app/index.js"
    }
  ]
}
